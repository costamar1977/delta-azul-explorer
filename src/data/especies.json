  {"id":"aguila-mora","nombreComun":"Águila mora","nombreCientifico":"Geranoaetus melanoleucus","familia":"Accipitridae","categoria":"ave","ecosistema":"andino-patagonico","descripcionBreve":"Rapaz grande de pecho blanco, común verla planeando sobre laderas abiertas.","rasgosDistintivos":["pecho blanco, dorso gris oscuro","cola corta característica","vuelo en planeo con alas en V poco marcada"],"habitat":["laderas abiertas","roquedales"],"temporada":"todo el año","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://aguila-mora.jpg","atributosFiltro":{"colorDominante":"gris/blanco","tamano":"grande","silueta":"rapaz"}},
  {"id":"zorzal-patagonico","nombreComun":"Zorzal patagónico","nombreCientifico":"Turdus falcklandii","familia":"Turdidae","categoria":"ave","ecosistema":"ambos","descripcionBreve":"Ave muy común y confiada, frecuente en el campamento buscando frutos e invertebrados en el suelo.","rasgosDistintivos":["dorso pardo, pico y anillo ocular amarillos","canto melodioso al amanecer","salta en el suelo buscando alimento"],"habitat":["bordes de bosque","zonas de campamento y jardines"],"temporada":"todo el año","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://zorzal-patagonico.jpg","atributosFiltro":{"colorDominante":"pardo","tamano":"mediano","silueta":"zorzal"}},
  {"id":"rayadito","nombreComun":"Rayadito","nombreCientifico":"Aphrastura spinicauda","familia":"Furnariidae","categoria":"ave","ecosistema":"ambos","descripcionBreve":"Ave pequeña e inquieta que recorre troncos y ramas buscando insectos, muy fácil de ver.","rasgosDistintivos":["ceja blanca marcada","cola con puntas rígidas en forma de espina","muy activo, siempre en movimiento"],"habitat":["troncos y ramas de bosque"],"temporada":"todo el año","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://rayadito.jpg","atributosFiltro":{"colorDominante":"pardo/blanco","tamano":"chico","silueta":"ave pequeña"}},
  {"id":"fio-fio","nombreComun":"Fío-fío","nombreCientifico":"Elaenia albiceps","familia":"Tyrannidae","categoria":"ave","ecosistema":"andino-patagonico","descripcionBreve":"Ave migratoria que llega en primavera; su canto repetitivo es uno de los sonidos típicos del verano en el bosque.","rasgosDistintivos":["copete gris que puede erizar","canto \"fío-fío\" repetido","tamaño chico y discreto"],"habitat":["bordes de bosque","claros"],"temporada":"migratoria, presente sep-mar","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://fio-fio.jpg","atributosFiltro":{"colorDominante":"gris/oliva","tamano":"chico","silueta":"ave pequeña"}},
  {"id":"picaflor-rubi","nombreComun":"Picaflor rubí / patagónico","nombreCientifico":"Sephanoides sephaniodes","familia":"Trochilidae","categoria":"ave","ecosistema":"ambos","descripcionBreve":"Único picaflor común de la región; poliniza notros y chilcos, y puede permanecer en invierno en zonas bajas.","rasgosDistintivos":["macho con corona roja brillante","vuelo estático frente a las flores","tamaño diminuto"],"habitat":["cerca de flores de notro, chilco y fucsia"],"temporada":"todo el año, más activo en primavera-verano","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://picaflor-rubi.jpg","atributosFiltro":{"colorDominante":"verde/rojo","tamano":"muy chico","silueta":"picaflor"}},
  {"id":"bandurria","nombreComun":"Bandurria","nombreCientifico":"Theristicus melanopis","familia":"Threskiornithidae","categoria":"ave","ecosistema":"andino-patagonico","descripcionBreve":"Ave grande de pastizales y mallines, con un llamado fuerte y característico en vuelo.","rasgosDistintivos":["pico largo curvo","cuello ocre y pecho gris","vuelo en pareja o grupos pequeños"],"habitat":["mallines","zonas abiertas de pastoreo"],"temporada":"todo el año","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://bandurria.jpg","atributosFiltro":{"colorDominante":"gris/ocre","tamano":"grande","silueta":"ibis"}},
  {"id":"tero","nombreComun":"Tero","nombreCientifico":"Vanellus chilensis","familia":"Charadriidae","categoria":"ave","ecosistema":"andino-patagonico","descripcionBreve":"Ave de zonas abiertas muy alerta y ruidosa, avisa con su grito ante cualquier intruso cerca del nido.","rasgosDistintivos":["copete fino en la cabeza","grito agudo y repetido \"tero-tero\"","alas con espolón visible en vuelo"],"habitat":["zonas abiertas de pastizal","cercanías del camping"],"temporada":"todo el año","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://tero.jpg","atributosFiltro":{"colorDominante":"gris/negro","tamano":"mediano","silueta":"ave de pastizal"}},
  {"id":"pitio","nombreComun":"Pitío","nombreCientifico":"Colaptes pitius","familia":"Picidae","categoria":"ave","ecosistema":"andino-patagonico","descripcionBreve":"Carpintero de tamaño mediano que también se alimenta en el suelo, a diferencia de otros carpinteros.","rasgosDistintivos":["dorso barrado pardo y ocre","con frecuencia forrajea en el suelo","llamado fuerte y repetitivo"],"habitat":["bosques abiertos","bordes de bosque"],"temporada":"todo el año","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://pitio.jpg","atributosFiltro":{"colorDominante":"pardo/ocre","tamano":"mediano","silueta":"carpintero"}},
  {"id":"cachudito","nombreComun":"Cachudito","nombreCientifico":"Anairetes parulus","familia":"Tyrannidae","categoria":"ave","ecosistema":"andino-patagonico","descripcionBreve":"Ave diminuta con un pequeño copete erecto, muy activa entre arbustos bajos.","rasgosDistintivos":["copete puntiagudo característico","pecho estriado","tamaño muy pequeño"],"habitat":["arbustos y matorral bajo"],"temporada":"todo el año","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://cachudito.jpg","atributosFiltro":{"colorDominante":"gris/blanco","tamano":"muy chico","silueta":"ave pequeña"}},

  {"id":"pudu","nombreComun":"Pudú","nombreCientifico":"Pudu puda","familia":"Cervidae","categoria":"mamifero","ecosistema":"valdiviano","descripcionBreve":"El ciervo más pequeño del mundo, tímido y solitario, típico del bosque húmedo con sotobosque denso.","rasgosDistintivos":["tamaño diminuto (30-40 cm de alzada)","pelaje pardo rojizo","machos con cuernitos simples sin ramificar"],"habitat":["sotobosque denso y húmedo"],"temporada":"todo el año, muy esquivo","estadoConservacion":"vulnerable","endemica":false,"indicadoraDe":"valdiviano","fotoUrl":"placeholder://pudu.jpg","atributosFiltro":{"colorDominante":"pardo rojizo","tamano":"muy chico","silueta":"ciervo pequeño"}},
  {"id":"huemul","nombreComun":"Huemul","nombreCientifico":"Hippocamelus bisulcus","familia":"Cervidae","categoria":"mamifero","ecosistema":"andino-patagonico","descripcionBreve":"Ciervo andino en peligro de extinción; el Parque Nacional Lago Puelo protege parte de su hábitat.","rasgosDistintivos":["pelaje pardo grisáceo","mancha oscura en forma de U en la cara","cuernos simples bifurcados en el macho"],"habitat":["bosque cercano a roquedales y altura"],"temporada":"todo el año, muy poco frecuente de ver","estadoConservacion":"en peligro","endemica":false,"indicadoraDe":"andino-patagonico","fotoUrl":"placeholder://huemul.jpg","atributosFiltro":{"colorDominante":"pardo grisáceo","tamano":"mediano","silueta":"ciervo"}},
  {"id":"zorro-culpeo","nombreComun":"Zorro colorado (culpeo)","nombreCientifico":"Lycalopex culpaeus","familia":"Canidae","categoria":"mamifero","ecosistema":"andino-patagonico","descripcionBreve":"El zorro más grande de la región, de hábitos oportunistas, a veces se acerca a zonas de campamento.","rasgosDistintivos":["pelaje rojizo con dorso grisáceo","cola larga y tupida con punta negra","tamaño similar a un perro mediano"],"habitat":["bosque y bordes abiertos"],"temporada":"todo el año","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://zorro-culpeo.jpg","atributosFiltro":{"colorDominante":"rojizo","tamano":"mediano","silueta":"zorro"}},
  {"id":"monito-de-monte","nombreComun":"Monito de monte","nombreCientifico":"Dromiciops gliroides","familia":"Microbiotheriidae","categoria":"mamifero","ecosistema":"valdiviano","descripcionBreve":"Marsupial nocturno diminuto y de linaje evolutivo antiquísimo, símbolo biogeográfico de la selva valdiviana.","rasgosDistintivos":["tamaño muy pequeño, similar a un ratón","cola prensil que acumula grasa","hábitos nocturnos y arborícolas"],"habitat":["bosque húmedo con quila densa"],"temporada":"todo el año, hiberna en invierno","estadoConservacion":"casi amenazado","endemica":false,"indicadoraDe":"valdiviano","fotoUrl":"placeholder://monito-de-monte.jpg","atributosFiltro":{"colorDominante":"pardo","tamano":"muy chico","silueta":"marsupial pequeño"}},
  {"id":"puma","nombreComun":"Puma","nombreCientifico":"Puma concolor","familia":"Felidae","categoria":"mamifero","ecosistema":"andino-patagonico","descripcionBreve":"El gran felino de la región, de hábitos muy esquivos; su presencia se nota más por huellas que por avistamientos.","rasgosDistintivos":["pelaje pardo uniforme sin manchas","cola larga con punta oscura","huellas grandes sin marca de uñas"],"habitat":["bosque y roquedales, gran territorio"],"temporada":"todo el año, muy difícil de ver","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://puma.jpg","atributosFiltro":{"colorDominante":"pardo","tamano":"grande","silueta":"felino"}},
  {"id":"huillin","nombreComun":"Huillín (nutria de río)","nombreCientifico":"Lontra provocax","familia":"Mustelidae","categoria":"mamifero","ecosistema":"ambos","descripcionBreve":"Mustélido semiacuático en peligro, presente en ríos y lagos de la región; muy sensible a la contaminación del agua.","rasgosDistintivos":["cuerpo alargado y pelaje pardo oscuro","cola gruesa en la base","nada con movimientos ondulantes"],"habitat":["ríos y orillas de lago con vegetación"],"temporada":"todo el año, hábitos discretos","estadoConservacion":"en peligro","endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://huillin.jpg","atributosFiltro":{"colorDominante":"pardo oscuro","tamano":"mediano","silueta":"nutria"}},
  {"id":"coipo","nombreComun":"Coipo (falsa nutria)","nombreCientifico":"Myocastor coypus","familia":"Echimyidae","categoria":"mamifero","ecosistema":"andino-patagonico","descripcionBreve":"Roedor semiacuático común en orillas de lago, a menudo confundido con el huillín (son especies distintas).","rasgosDistintivos":["dientes incisivos naranjas muy visibles","cola redonda tipo rata, no aplanada","más común y confiado que el huillín"],"habitat":["orillas de lago y lagunas con vegetación"],"temporada":"todo el año","estadoConservacion":null,"endemica":false,"indicadoraDe":null,"fotoUrl":"placeholder://coipo.jpg","atributosFiltro":{"colorDominante":"pardo","tamano":"mediano","silueta":"roedor semiacuatico"}},
  {"id":"guina","nombreComun":"Güiña","nombreCientifico":"Leopardus guigna","familia":"Felidae","categoria":"mamifero","ecosistema":"valdiviano","descripcionBreve":"El felino silvestre más pequeño de América, nocturno y extremadamente esquivo, asociado a bosque denso.","rasgosDistintivos":["tamaño similar a un gato doméstico","pelaje moteado pardo","hábitos estrictamente nocturnos"],"habitat":["bosque denso con buena cobertura"],"temporada":"todo el año, casi nunca se ve","estadoConservacion":"vulnerable","endemica":false,"indicadoraDe":"valdiviano","fotoUrl":"placeholder://guina.jpg","atributosFiltro":{"colorDominante":"pardo moteado","tamano":"chico","silueta":"felino pequeño"}},

