  {"id":"ciervo-volante-patagonico","nombreComun":"Ciervo volante patagónico (escarabajo de Darwin)","nombreCientifico":"Chiasognathus grantii","familia":"Lucanidae","categoria":"otro","ecosistema":"valdiviano","descripcionBreve":"Escarabajo grande y llamativo con mandíbulas enormes en el macho, descripto por Charles Darwin en su viaje por la región.","rasgosDistintivos":["mandíbulas largas en forma de tenaza en el macho","élitros de color metálico verdoso o cobrizo","tamaño grande para un insecto de la zona"],"habitat":["troncos en descomposición en bosque húmedo"],"temporada":"más frecuente en verano","estadoConservacion":null,"endemica":false,"indicadoraDe":"valdiviano","fotoUrl":"placeholder://ciervo-volante-patagonico.jpg","atributosFiltro":{"colorDominante":"verde metalico/cobrizo","tamano":"chico","silueta":"escarabajo"}}
