# Copiar este archivo a .env.local y completar con las keys reales.
# Sin estas variables, el modo foto con IA queda en "modo demo" (deshabilitado
# con mensaje explicativo), pero el resto de la app funciona igual.

# Pl@ntNet (identificación de flora) - pedir en https://my.plantnet.org/
VITE_PLANTNET_API_KEY=

# iNaturalist (identificación de fauna) - token OAuth de usuario, ver README
VITE_INATURALIST_TOKEN=
